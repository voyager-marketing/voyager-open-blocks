{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Logo marquee pattern",
		"description": "The logo marquee in its two layouts: voyager-open/logo-marquee, a row of placeholder logos that drifts when it is wider than the screen, and voyager-open/logo-marquee-grid, the same logos in a still grid.",
		"author": "voyager-marketing",
		"categories": [
			"Blocks"
		]
	},
	"landingPage": "/voyager-open/logo-marquee/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/voyager-marketing/voyager-open-blocks",
				"ref": "main",
				"refType": "branch"
			},
			"options": {
				"activate": true,
				"targetFolderName": "voyager-open-blocks"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; require WP_PLUGIN_DIR . '/voyager-open-blocks/playground/seed.php';"
		}
	]
}
