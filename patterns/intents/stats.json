{
	"title": "Stats",
	"section": "stats",
	"layout": "row",
	"description": "Three figures from Site Data in a row at wide width: the year founded, the average rating and the review count, each its value at x-large with a short label under it. Every value is bound, so the page shows only what the site owner typed in, and a figure whose field is empty shows its own text, which names the field. The figures stack on a phone.",
	"categories": [
		"voyager-open",
		"about"
	],
	"viewportWidth": 1280,
	"keywords": [
		"stats",
		"figures",
		"numbers",
		"rating",
		"reviews",
		"founded",
		"at a glance"
	],
	"copy_rules": {
		"Founded value": {
			"purpose": "Bound to the Site Data year founded, which the site owner types in. Its own text names the field and shows only while the field is empty: leave the whole figure out then, with omit. Never type a year.",
			"min": 1,
			"max": 12,
			"required": true,
			"claim": true
		},
		"Founded label": {
			"purpose": "What the figure is, in a few words, such as Year founded. It names the figure and adds no claim of its own.",
			"min": 3,
			"max": 24,
			"required": true,
			"claim": false
		},
		"Rating value": {
			"purpose": "Bound to the Site Data rating, which the site owner types in. Its own text names the field and shows only while the field is empty: leave the whole figure out then, with omit. Never type a rating.",
