{
	"title": "Closing CTA beside an image",
	"section": "closing-cta",
	"layout": "split",
	"description": "A closing band at the end of a page: heading, one line of copy, a primary button and an email button bound to voyager/site-data, beside a 4:3 image slot that stacks below the text on a phone.",
	"categories": [ "voyager-open", "call-to-action" ],
	"keywords": [ "cta", "closing", "final", "contact", "email", "image" ],
	"viewportWidth": 1280,
	"copy_rules": {
		"Heading": {
			"purpose": "The page's last h2: one short sentence that invites the reader to get in touch. No price, rating, licence or promise unless the owner gave it.",
			"min": 10,
			"max": 60,
			"required": true,
			"claim": false
		},
		"Body": {
			"purpose": "One line on how to reach the business and what happens next. No price, rating, licence or promise unless the owner gave it.",
			"min": 20,
			"max": 120,
			"required": true,
			"claim": false
		},
		"Primary button": {
			"purpose": "The page's last main action, as what happens when it is pressed, such as Book an estimate.",
			"min": 2,
			"max": 24,
			"required": true,
			"claim": false
		},
		"Email button": {
			"purpose": "The second button's label. Its link is bound to the Site Data email address, and its text is its own, so name the action, such as Email us, never the address.",
			"min": 2,
			"max": 24,
			"required": true,
			"claim": false
		}
	},
	"intent": {
		"blocks": [
			{
				"block": "core/group",
				"attrs": {
					"tagName": "section",
					"align": "full",
					"metadata": { "name": "Closing CTA" },
					"style": {
						"spacing": {
							"padding": {
								"top": "max(var(--wp--preset--spacing--60), var(--wp--preset--spacing--70, 0px))",
								"bottom": "max(var(--wp--preset--spacing--60), var(--wp--preset--spacing--70, 0px))",
								"left": "var:preset|spacing|50",
								"right": "var:preset|spacing|50"
							}
						}
					},
					"layout": { "type": "constrained" }
				},
				"children": [
					{
						"block": "core/columns",
						"attrs": {
							"align": "wide",
							"verticalAlignment": "center",
							"metadata": { "name": "Columns" },
							"style": {
								"spacing": {
									"blockGap": {
										"top": "var:preset|spacing|50",
										"left": "var:preset|spacing|60"
									}
								}
							}
						},
						"children": [
							{
								"block": "core/column",
								"attrs": {
									"verticalAlignment": "center",
									"metadata": { "name": "Text" },
									"style": { "spacing": { "blockGap": "var:preset|spacing|40" } }
								},
								"children": [
									{
										"block": "core/heading",
										"level": 2,
										"text": "Ready when you are.",
										"attrs": { "metadata": { "name": "Heading" } }
									},
									{
										"block": "core/paragraph",
										"text": "Book a call or send a message, and we will take it from there.",
										"attrs": { "metadata": { "name": "Body" } }
									},
									{
										"block": "core/buttons",
										"children": [
											{ "block": "core/button", "text": "Get in touch", "url": "/contact/", "attrs": { "metadata": { "name": "Primary button" } } },
											{
												"block": "core/button",
												"text": "Email us",
												"url": "/contact/",
												"attrs": {
													"className": "is-style-outline",
													"metadata": {
														"name": "Email button",
														"bindings": {
															"url": { "source": "voyager/site-data", "args": { "key": "email_link" } }
														}
													}
												}
											}
										]
									}
								]
							},
							{
								"block": "core/column",
								"attrs": { "verticalAlignment": "center", "metadata": { "name": "Image column" } },
								"children": [
									{
										"block": "core/image",
										"url": "/voyager-open-blocks-assets/placeholders/image-4x3.svg",
										"alt": "",
										"attrs": { "aspectRatio": "4/3", "scale": "cover", "metadata": { "name": "Image" } }
									}
								]
							}
						]
					}
				]
			}
		]
	}
}
