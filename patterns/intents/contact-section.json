{
	"title": "Contact section",
	"description": "Contact details bound to voyager/site-data (phone, email, address, hours) beside a form slot. The slot holds an email fallback until a form plugin's block replaces it.",
	"categories": [
		"voyager-open",
		"contact"
	],
	"keywords": [
		"contact",
		"form",
		"phone",
		"email",
		"address",
		"hours"
	],
	"viewportWidth": 1280,
	"copy_rules": {
		"Heading": {
			"purpose": "The section's h2: an invitation to get in touch, in a few words.",
			"min": 3,
			"max": 60,
			"required": true,
			"claim": false
		},
		"Body": {
			"purpose": "One line on the ways to reach the business, or when. Leave it out when the details say enough.",
			"min": 20,
			"max": 120,
			"required": false,
			"claim": false
		},
		"Phone": {
			"purpose": "Bound to the Site Data phone number. Its own text, a sample 555 number, shows only while the number is empty.",
			"min": 2,
			"max": 40,
			"required": false,
			"claim": false
		},
		"Email": {
			"purpose": "Bound to the Site Data email address. Its own text, an example.com address, shows only while the address is empty.",
			"min": 2,
			"max": 60,
			"required": false,
			"claim": false
		},
		"Street address": {
			"purpose": "Bound to the Site Data street address. Its own text, a sample street, shows only while the street address is empty.",
			"min": 2,
			"max": 80,
			"required": false,
			"claim": false
		},
		"City, state, postal code": {
			"purpose": "Bound to the Site Data city, state or region and postal code, shown as one line. Its own text, a sample town, shows only while all three are empty.",
			"min": 2,
			"max": 80,
			"required": false,
			"claim": false
		},
		"Hours": {
			"purpose": "Bound to the Site Data business hours. Its own text, sample weekday hours, shows only while the hours are empty.",
			"min": 2,
			"max": 80,
			"required": false,
			"claim": false
		},
		"Click to call": {
			"purpose": "The call button's label. Its link is bound to the Site Data phone number, and its text is its own, so name the action, such as Call us, never the number. Leave it out with the Phone line.",
			"min": 2,
			"max": 24,
			"required": false,
			"claim": false
		},
		"Form heading": {
			"purpose": "The form slot's h3: what the visitor can send, in a few words.",
			"min": 3,
			"max": 40,
			"required": true,
			"claim": false
		},
		"Form body": {
			"purpose": "One line on what to put in the message, until a form plugin's block replaces the slot.",
			"min": 20,
			"max": 120,
			"required": true,
			"claim": false
		},
		"Email button": {
			"purpose": "The form slot's one fill button, until a form plugin's block replaces it. Its link is bound to the Site Data email address, and its text is its own, so name the action, such as Email us, never the address.",
			"min": 2,
			"max": 24,
			"required": true,
			"claim": false
		}
	},
	"intent": {
		"blocks": [
			{
				"block": "core/group",
				"attrs": {
					"tagName": "section",
					"align": "full",
					"metadata": {
						"name": "Contact section"
					},
					"style": {
						"spacing": {
							"padding": {
								"top": "var:preset|spacing|60",
								"bottom": "var:preset|spacing|60",
								"left": "var:preset|spacing|50",
								"right": "var:preset|spacing|50"
							}
						}
					},
					"layout": {
						"type": "constrained"
					}
				},
				"children": [
					{
						"block": "core/columns",
						"attrs": {
							"align": "wide",
							"style": {
								"spacing": {
									"blockGap": {
										"top": "var:preset|spacing|50",
										"left": "var:preset|spacing|60"
									}
								}
							}
						},
						"children": [
							{
								"block": "core/column",
								"attrs": {
									"width": "40%",
									"metadata": {
										"name": "Contact details"
									}
								},
								"children": [
									{
										"block": "core/heading",
										"level": 2,
										"text": "Get in touch",
										"attrs": {
											"metadata": {
												"name": "Heading"
											}
										}
									},
									{
										"block": "core/paragraph",
										"text": "Call, email or stop by during business hours.",
										"attrs": {
											"metadata": {
												"name": "Body"
											}
										}
									},
									{
										"block": "core/group",
										"attrs": {
											"metadata": {
												"name": "Details"
											},
											"style": {
												"spacing": {
													"blockGap": "var:preset|spacing|20"
												}
											},
											"layout": {
												"type": "default"
											}
										},
										"children": [
											{
												"block": "core/paragraph",
												"text": "(555) 010-0100",
												"attrs": {
													"metadata": {
														"name": "Phone",
														"bindings": {
															"content": {
																"source": "voyager/site-data",
																"args": {
																	"key": "phone"
																}
															}
														}
													}
												}
											},
											{
												"block": "core/paragraph",
												"text": "hello@example.com",
												"attrs": {
													"metadata": {
														"name": "Email",
														"bindings": {
															"content": {
																"source": "voyager/site-data",
																"args": {
																	"key": "email"
																}
															}
														}
													}
												}
											},
											{
												"block": "core/group",
												"attrs": {
													"metadata": {
														"name": "Address"
													},
													"style": {
														"spacing": {
															"blockGap": "0px"
														}
													},
													"layout": {
														"type": "default"
													}
												},
												"children": [
													{
														"block": "core/paragraph",
														"text": "100 Main Street",
														"attrs": {
															"metadata": {
																"name": "Street address",
																"bindings": {
																	"content": {
																		"source": "voyager/site-data",
																		"args": {
																			"key": "address"
																		}
																	}
																}
															}
														}
													},
													{
														"block": "core/paragraph",
														"text": "Springfield, ST 00000",
														"attrs": {
															"metadata": {
																"name": "City, state, postal code",
																"bindings": {
																	"content": {
																		"source": "voyager/site-data",
																		"args": {
																			"key": "address_locality"
																		}
																	}
																}
															}
														}
													}
												]
											},
											{
												"block": "core/paragraph",
												"text": "Monday to Friday, 9am to 5pm",
												"attrs": {
													"metadata": {
														"name": "Hours",
														"bindings": {
															"content": {
																"source": "voyager/site-data",
																"args": {
																	"key": "hours"
																}
															}
														}
													}
												}
											}
										]
									},
									{
										"block": "core/buttons",
										"children": [
											{
												"block": "core/button",
												"text": "Call us",
												"url": "/contact/",
												"attrs": {
													"className": "is-style-outline",
													"metadata": {
														"name": "Click to call",
														"bindings": {
															"url": {
																"source": "voyager/site-data",
																"args": {
																	"key": "phone_link"
																}
															}
														}
													}
												}
											}
										]
									}
								]
							},
							{
								"block": "core/column",
								"attrs": {
									"width": "60%",
									"metadata": {
										"name": "Form slot"
									}
								},
								"children": [
									{
										"block": "core/group",
										"attrs": {
											"metadata": {
												"name": "Form"
											},
											"style": {
												"border": {
													"width": "1px",
													"style": "solid"
												},
												"spacing": {
													"padding": {
														"top": "var:preset|spacing|50",
														"bottom": "var:preset|spacing|50",
														"left": "var:preset|spacing|50",
														"right": "var:preset|spacing|50"
													}
												},
												"dimensions": {
													"minHeight": "100%"
												}
											},
											"layout": {
												"type": "constrained"
											}
										},
										"children": [
											{
												"block": "core/heading",
												"level": 3,
												"text": "Send us a note",
												"attrs": {
													"metadata": {
														"name": "Form heading"
													}
												}
											},
											{
												"block": "core/paragraph",
												"text": "Tell us a little about what you need and how to reach you.",
												"attrs": {
													"metadata": {
														"name": "Form body"
													}
												}
											},
											{
												"block": "core/buttons",
												"children": [
													{
														"block": "core/button",
														"text": "Email us",
														"url": "/contact/",
														"attrs": {
															"metadata": {
																"name": "Email button",
																"bindings": {
																	"url": {
																		"source": "voyager/site-data",
																		"args": {
																			"key": "email_link"
																		}
																	}
																}
															}
														}
													}
												]
											}
										]
									}
								]
							}
						]
					}
				]
			}
		]
	}
}
