{
	"title": "Closing CTA",
	"description": "A centered closing band at the end of a page: heading, one line of copy, a primary button and an email button bound to voyager/site-data.",
	"categories": [ "voyager-open", "call-to-action" ],
	"keywords": [ "cta", "closing", "final", "contact", "email" ],
	"viewportWidth": 1280,
	"copy_rules": {
		"Heading": {
			"purpose": "The page's last h2: one short sentence that invites the reader to get in touch.",
			"min": 10,
			"max": 60,
			"required": true,
			"claim": false
		},
		"Body": {
			"purpose": "One line on how to reach the business and what happens next.",
			"min": 20,
			"max": 120,
			"required": true,
			"claim": false
		},
		"Primary button": {
			"purpose": "The page's last main action, as what happens when it is pressed, such as Book an estimate.",
			"min": 2,
			"max": 24,
			"required": true,
			"claim": false
		},
		"Email button": {
			"purpose": "The second button's label. Its link is bound to the Site Data email address, and its text is its own, so name the action, such as Email us, never the address.",
			"min": 2,
			"max": 24,
			"required": true,
			"claim": false
		}
	},
	"intent": {
		"blocks": [
			{
				"block": "core/group",
				"attrs": {
					"tagName": "section",
					"align": "full",
					"metadata": { "name": "Closing CTA" },
					"style": {
						"spacing": {
							"padding": {
								"top": "var:preset|spacing|60",
								"bottom": "var:preset|spacing|60",
								"left": "var:preset|spacing|50",
								"right": "var:preset|spacing|50"
							},
							"blockGap": "var:preset|spacing|40"
						}
					},
					"layout": { "type": "constrained", "contentSize": "720px" }
				},
				"children": [
					{
						"block": "core/heading",
						"level": 2,
						"text": "Ready when you are.",
						"attrs": { "metadata": { "name": "Heading" }, "style": { "typography": { "textAlign": "center" } } }
					},
					{
						"block": "core/paragraph",
						"text": "Book a call or send a message, and we will take it from there.",
						"attrs": { "metadata": { "name": "Body" }, "style": { "typography": { "textAlign": "center" } } }
					},
					{
						"block": "core/buttons",
						"attrs": { "layout": { "type": "flex", "justifyContent": "center" } },
						"children": [
							{ "block": "core/button", "text": "Get in touch", "url": "/contact/", "attrs": { "metadata": { "name": "Primary button" } } },
							{
								"block": "core/button",
								"text": "Email us",
								"url": "/contact/",
								"attrs": {
									"className": "is-style-outline",
									"metadata": {
										"name": "Email button",
										"bindings": {
											"url": { "source": "voyager/site-data", "args": { "key": "email_link" } }
										}
									}
								}
							}
						]
					}
				]
			}
		]
	}
}
