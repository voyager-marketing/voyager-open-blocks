{
	"title": "Logo marquee",
	"description": "An eyebrow over a row of logos that drifts sideways when it is wider than the screen (core/group Marquee style). Ships placeholder logos to replace with the site's own media.",
	"categories": [ "voyager-open", "media" ],
	"keywords": [ "logos", "clients", "partners", "marquee", "brands", "strip" ],
	"viewportWidth": 1280,
	"intent": {
		"blocks": [
			{
				"block": "core/group",
				"attrs": {
					"tagName": "section",
					"align": "full",
					"metadata": { "name": "Logo marquee" },
					"style": {
						"spacing": {
							"padding": {
								"top": "var:preset|spacing|50",
								"bottom": "var:preset|spacing|50",
								"left": "var:preset|spacing|50",
								"right": "var:preset|spacing|50"
							},
							"blockGap": "var:preset|spacing|40"
						}
					},
					"layout": { "type": "constrained" }
				},
				"children": [
					{
						"block": "core/paragraph",
						"text": "Some of the teams we work with",
						"attrs": {
							"metadata": { "name": "Eyebrow" },
							"fontSize": "small",
							"style": { "typography": { "textAlign": "center", "textTransform": "uppercase", "letterSpacing": "0.08em" } }
						}
					},
					{
						"block": "core/group",
						"attrs": {
							"align": "wide",
							"className": "is-style-voyager-open-marquee",
							"metadata": { "name": "Marquee" },
							"layout": { "type": "default" }
						},
						"children": [
							{
								"block": "core/group",
								"attrs": {
									"metadata": { "name": "Logos" },
									"style": { "spacing": { "blockGap": "var:preset|spacing|60" } },
									"layout": { "type": "flex", "flexWrap": "nowrap", "verticalAlignment": "center", "justifyContent": "center" }
								},
								"children": [
									{ "block": "core/image", "url": "/voyager-open-blocks-assets/placeholders/logo-1.svg", "alt": "Placeholder logo", "attrs": { "height": "40px", "scale": "contain" } },
									{ "block": "core/image", "url": "/voyager-open-blocks-assets/placeholders/logo-2.svg", "alt": "Placeholder logo", "attrs": { "height": "40px", "scale": "contain" } },
									{ "block": "core/image", "url": "/voyager-open-blocks-assets/placeholders/logo-3.svg", "alt": "Placeholder logo", "attrs": { "height": "40px", "scale": "contain" } },
									{ "block": "core/image", "url": "/voyager-open-blocks-assets/placeholders/logo-4.svg", "alt": "Placeholder logo", "attrs": { "height": "40px", "scale": "contain" } },
									{ "block": "core/image", "url": "/voyager-open-blocks-assets/placeholders/logo-5.svg", "alt": "Placeholder logo", "attrs": { "height": "40px", "scale": "contain" } },
									{ "block": "core/image", "url": "/voyager-open-blocks-assets/placeholders/logo-6.svg", "alt": "Placeholder logo", "attrs": { "height": "40px", "scale": "contain" } }
								]
							}
						]
					}
				]
			}
		]
	}
}
