{
	"title": "Proof strip",
	"description": "One ruled row of three to six checkmarked credentials, usually right under a hero. Uses the core/list Ticks style.",
	"categories": [
		"voyager-open",
		"about"
	],
	"keywords": [
		"proof",
		"credentials",
		"trust",
		"license",
		"strip",
		"checkmarks"
