								"attrs": {
									"metadata": {
										"name": "Credential 3"
									}
								}
							},
							{
								"block": "core/list-item",
								"text": "Same-week scheduling",
								"attrs": {
									"metadata": {
										"name": "Credential 4"
									}
								}
							}
