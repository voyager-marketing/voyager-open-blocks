# PHPStan at level max with WordPress stubs. No baseline: a new error is fixed,
# not recorded. Run it with `composer phpstan`.
includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: max
	phpVersion: 80100

	paths:
		- voyager-open-blocks.php
		- inc
		- src

	typeAliases:
		# A block as parse_blocks() returns it.
		Block: 'array{blockName: string|null, attrs: array<mixed>, innerBlocks: array<array<mixed>>, innerHTML: string, innerContent: array<mixed>}'
		# One row of BlockTree\describe().
		Row: 'array{path: string, block: string, label?: string, bindings?: array<mixed>, pattern?: string, copy?: bool}'
