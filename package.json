{
	"name": "voyager-open-blocks",
	"version": "0.7.0",
	"private": true,
	"description": "Agent-ready WordPress blocks, binding sources and patterns, each with a SKILL.md, built on the Wesper to Block Runner loop.",
	"license": "GPL-2.0-or-later",
	"author": "Voyager Marketing",
	"homepage": "https://github.com/voyager-marketing/voyager-open-blocks",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voyager-marketing/voyager-open-blocks.git"
	},
	"engines": {
		"node": "^22.23.4 || ^24.22.1 || >=26.12.1"
	},
	"files": [
		"build",
		"inc",
		"assets",
		"patterns",
		"skills",
		"blueprints",
		"blueprint.json",
		"voyager-open-blocks.php",
		"uninstall.php",
		"DESIGN.md",
		"LICENSE",
		"README.md",
		"readme.txt"
	],
	"scripts": {
		"build": "wp-scripts build --blocks-manifest",
		"start": "wp-scripts start --blocks-manifest",
		"zip": "wp-scripts plugin-zip",
		"lint:js": "wp-scripts lint-js src scripts assets",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"patterns:build": "node scripts/build-patterns.mjs",
		"patterns:validate": "block-runner validate \"patterns/*.html\" --strict --json",
		"dev": "node scripts/dev.mjs",
		"screenshots": "node scripts/screenshots.mjs",
		"playground": "node scripts/playground.mjs",
		"context": "node scripts/context.mjs",
		"check": "node scripts/check.mjs",
		"check:site-data": "node scripts/site-data-fixture-check.mjs",
		"check:resolution": "node scripts/binding-resolution-check.mjs",
		"check:bindable-meta": "node scripts/bindable-meta-check.mjs",
		"check:usage-index": "node scripts/usage-index-check.mjs",
		"lint:design": "designmd lint DESIGN.md",
		"changelog:fold": "node scripts/fold-unreleased.mjs",
		"test:fold": "node --test scripts/test-fold-unreleased.mjs",
		"test:cache-check": "node --test scripts/test-cache-check.mjs",
		"cache-check": "node scripts/cache-check.mjs",
		"e2e": "node scripts/e2e.mjs",
		"e2e:editor": "node scripts/e2e-editor.mjs",
		"contrast": "node scripts/contrast-check.mjs",
		"plugin-check": "node scripts/plugin-check.mjs"
	},
	"devDependencies": {
		"@google/design.md": "0.4.0",
		"@wordpress/scripts": "37.0.0",
		"@wp-playground/cli": "3.1.60",
		"block-runner": "1.0.0",
		"wesper": "0.5.0"
	}
}
