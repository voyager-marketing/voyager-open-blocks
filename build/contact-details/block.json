{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "voyager-open/contact-details",
  "version": "0.1.0",
  "title": "Contact details",
  "category": "text",
  "icon": "location",
  "description": "Your address, phone, email and hours. The phone dials and the email opens a new message when tapped. Bind each part to Site Data to show your details.",
  "keywords": [
    "contact",
    "address",
    "phone",
    "email",
    "hours"
  ],
  "textdomain": "voyager-open-blocks",
  "attributes": {
    "phone": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "phoneLink": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "email": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "emailLink": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "address": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "addressLocality": {
      "type": "string",
      "default": "",
      "role": "content"
    },
    "hours": {
      "type": "string",
      "default": "",
      "role": "content"
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "color": {
      "text": true,
      "background": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "example": {
    "attributes": {
      "address": "Street address",
      "addressLocality": "City, state, postal code",
      "phone": "Phone number",
      "phoneLink": "tel:5550100100",
      "email": "Email address",
      "emailLink": "mailto:hello@example.com",
      "hours": "Business hours"
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}