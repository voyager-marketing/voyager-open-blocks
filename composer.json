{
	"name": "voyager-marketing/voyager-open-blocks",
	"description": "Agent-ready WordPress blocks, patterns and binding sources, with abilities an AI agent can call to place, configure and bind them.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/voyager-marketing/voyager-open-blocks",
	"support": {
		"issues": "https://github.com/voyager-marketing/voyager-open-blocks/issues",
		"source": "https://github.com/voyager-marketing/voyager-open-blocks",
		"security": "https://github.com/voyager-marketing/voyager-open-blocks/security/policy"
	},
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"php-stubs/wordpress-stubs": "^7.1",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^10.5",
		"szepeviktor/phpstan-wordpress": "^2.0"
	},
	"autoload-dev": {
		"psr-4": {
			"VoyagerOpenBlocks\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse --memory-limit=2G",
		"test": "phpunit --testsuite Unit"
	},
	"scripts-descriptions": {
		"phpstan": "PHPStan at level max over the plugin file, inc/ and the render files. No baseline.",
		"test": "PHPUnit unit suite. No WordPress is loaded."
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.1.0"
		}
	}
}
